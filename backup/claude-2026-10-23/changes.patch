@@ -0,0 +1,120 @@
+{% extends "base.html" %}
+
+{% block title %}Transcripts and Recommendation Letters — letters view{% endblock %}
+
+{% block body %}
+<div class="view-controls">
+  <div>
+    <label for="rank-filter">Group rank</label>
+    <select id="rank-filter">
+      <option value="">All</option>
+      {% for r in group_ranks %}<option value="{{ r }}">{{ r|capitalize }}</option>{% endfor %}
+    </select>
+  </div>
+  <button type="button" class="secondary" onclick="location.reload()"
+          title="Read the letters folder again, e.g. after an upload">Reload</button>
+</div>
+
+{% if error %}<div class="error">{{ error }}</div>{% endif %}
+
+{% if students %}
+  <h2>Recommendation letters</h2>
+  <p class="hint" style="margin-top:-.4rem">
+    One row per student with letters in <code>{{ folder }}</code>. Group rank combines the
+    student's letter ranks (after post_rank): very excellent, all excellent; excellent, at
+    least one excellent and the rest good; very good, all good; good, at least one good;
+    normal, all normal. Click a column name to sort; click a student to open their details.
+    <span id="shown-count"></span>
+  </p>
+  <div class="table-wrap scroll">
+  <table id="letter-students">
+    <thead>
+      <tr>
+        <th><button type="button" class="sort">Student</button></th>
+        <th class="num" data-type="num"><button type="button" class="sort">Letters</button></th>
+        <th data-type="num" aria-sort="descending"><button type="button" class="sort">Group rank</button></th>
+      </tr>
+    </thead>
+    <tbody>
+      {% for s in students %}
+      <tr data-index="{{ loop.index0 }}" data-rank="{{ s.group_rank or '' }}">
+        <td><a href="#" class="student-link" data-file="{{ s.file }}"
+               data-transcript="{{ 1 if s.has_transcript else 0 }}">{{ s.student }}</a></td>
+        <td class="num" data-sort="{{ s.letters }}">{{ s.letters }}</td>
+        {# very excellent sorts highest; a student without ranked letters last #}
+        <td data-sort="{{ group_ranks|length - group_ranks.index(s.group_rank) if s.group_rank in group_ranks else '' }}">
+          {{- s.group_rank or '–' -}}</td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+  </div>
+{% endif %}
+
+{% include "_student_dialog.html" %}
+
+<script>
+(() => {
+  const table = document.getElementById("letter-students");
+  if (!table) return;
+  const body = table.tBodies[0];
+
+  // ---- sorting: numbers high-to-low first, text A-Z; then toggle ----------
+  const headers = [...table.tHead.rows[0].cells];
+  const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: "base" });
+  function sortBy(index) {
+    const th = headers[index];
+    const numeric = th.dataset.type === "num";
+    const current = th.getAttribute("aria-sort");
+    const direction = current
+      ? (current === "ascending" ? "descending" : "ascending")
+      : (numeric ? "descending" : "ascending");
+    const sign = direction === "ascending" ? 1 : -1;
+    const key = (row) => numeric ? row.cells[index].dataset.sort : row.cells[index].textContent.trim();
+    const rows = [...body.rows];
+    rows.sort((a, b) => {
+      const x = key(a), y = key(b);
+      if (x === "" || y === "") return (x === "") - (y === "");
+      const order = numeric ? Number(x) - Number(y) : collator.compare(x, y);
+      return sign * order || Number(a.dataset.index) - Number(b.dataset.index);
+    });
+    body.append(...rows);
+    headers.forEach((h) => h.removeAttribute("aria-sort"));
+    th.setAttribute("aria-sort", direction);
+  }
+  headers.forEach((th, i) => th.querySelector("button.sort").addEventListener("click", () => sortBy(i)));
+  // Open sorted by group rank, best first (the header already shows that).
+  headers[2].removeAttribute("aria-sort");
+  sortBy(2);
+
+  // ---- group rank filter ----------------------------------------------------
+  const filterSelect = document.getElementById("rank-filter");
+  const shown = document.getElementById("shown-count");
+  function filter() {
+    const want = filterSelect.value;
+    let count = 0;
+    for (const row of body.rows) {
+      row.hidden = Boolean(want) && row.dataset.rank !== want;
+      if (!row.hidden) count++;
+    }
+    const total = body.rows.length;
+    shown.textContent = count === total ? `${total} students.` : `Showing ${count} of ${total} students.`;
+  }
+  filterSelect.addEventListener("change", filter);
+  filter();
+
+  // ---- student link: the shared student dialog --------------------------------
+  const builder = {{ builder|tojson }};
+  const category = {{ category|tojson }};
+  body.addEventListener("click", (e) => {
+    const link = e.target.closest("a.student-link");
+    if (!link) return;
+    e.preventDefault();
+    // A student without a transcript is in no category's results: letters only.
+    const withCourses = link.dataset.transcript === "1" && category;
+    openStudent(link.dataset.file, { builder, category: withCourses ? category : "",
+                                     title: link.textContent });
+  });
+})();
+</script>
+{% endblock %}
diff --git a/backup/claude-2026-10-23/tests/test_letters.py b/tests/test_letters.py
