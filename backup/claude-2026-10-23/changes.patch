diff --git a/backup/claude-2026-10-23/browser_view/templates/_student_dialog.html b/browser_view/templates/_student_dialog.html
new file mode 100644
index 0000000..ddffc14
--- /dev/null
+++ b/browser_view/templates/_student_dialog.html
@@ -0,0 +1,194 @@
+{# The student dialog, shared by Transcripts → View and Recommendations → View.
+   openStudent(file, {builder, category, title}) opens it for the transcript
+   named ``file``: a Transcript tab (PDF and, given a category, its courses) and
+   a Recommendation letters tab (each letter's post_rank rank and its PDF). #}
+<dialog id="student-dialog" aria-labelledby="student-title">
+  <div class="dialog-head">
+    <div>
+      <h2 id="student-title"></h2>
+      <p class="hint" id="student-meta"></p>
+    </div>
+    <button type="button" class="close" aria-label="Close">×</button>
+  </div>
+  <div class="dialog-tabs" role="tablist">
+    <button type="button" role="tab" id="tab-transcript" aria-controls="panel-transcript" aria-selected="true">Transcript</button>
+    <button type="button" role="tab" id="tab-letters" aria-controls="panel-letters" aria-selected="false">Recommendation letters</button>
+  </div>
+  <div class="dialog-body" id="panel-transcript" role="tabpanel" aria-labelledby="tab-transcript">
+    <section class="pdf-pane" id="pdf-pane" aria-label="Original transcript"></section>
+    <section class="courses-pane" id="courses-pane" aria-label="Extracted courses"></section>
+  </div>
+  <div class="dialog-body" id="panel-letters" role="tabpanel" aria-labelledby="tab-letters" hidden>
+    <section class="pdf-pane" id="letter-pdf-pane" aria-label="Recommendation letter"></section>
+    <section class="courses-pane" id="letters-pane" aria-label="Recommendation letters"></section>
+  </div>
+</dialog>
+
+<script>
+window.openStudent = (() => {
+  const dialog = document.getElementById("student-dialog");
+  const title = document.getElementById("student-title");
+  const meta = document.getElementById("student-meta");
+  const pdfPane = document.getElementById("pdf-pane");
+  const coursesPane = document.getElementById("courses-pane");
+  const letterPdfPane = document.getElementById("letter-pdf-pane");
+  const lettersPane = document.getElementById("letters-pane");
+  const tabs = {
+    transcript: [document.getElementById("tab-transcript"), document.getElementById("panel-transcript")],
+    letters: [document.getElementById("tab-letters"), document.getElementById("panel-letters")],
+  };
+
+  dialog.querySelector(".close").addEventListener("click", () => dialog.close());
+  // A click on the backdrop lands on the dialog element itself.
+  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
+  // Unload the PDFs on close so the next student never flashes the last one.
+  dialog.addEventListener("close", () => { pdfPane.replaceChildren(); letterPdfPane.replaceChildren(); });
+
+  function showTab(name) {
+    for (const [key, [tab, panel]] of Object.entries(tabs)) {
+      tab.setAttribute("aria-selected", String(key === name));
+      panel.hidden = key !== name;
+    }
+  }
+  for (const [key, [tab]] of Object.entries(tabs)) tab.addEventListener("click", () => showTab(key));
+
+  // textContent throughout: course titles and names come from PDFs.
+  function el(tag, text, className) {
+    const node = document.createElement(tag);
+    if (text !== undefined && text !== null) node.textContent = text;
+    if (className) node.className = className;
+    return node;
+  }
+  const fmt = (n, digits) => (n === null || n === undefined ? "–" : Number(n).toFixed(digits));
+
+  // A PDF with its name and an "Open in a new tab" link, as both tabs show it.
+  function showPdf(pane, file, url, label, missing) {
+    if (!url) {
+      pane.replaceChildren(el("div", missing, "error"));
+      return;
+    }
+    const frame = el("iframe");
+    frame.src = url;
+    frame.title = label;
+    const link = el("a", "Open in a new tab");
+    link.href = url;
+    link.target = "_blank";
+    link.rel = "noopener";
+    const caption = el("p", null, "hint");
+    caption.style.margin = "0 0 .5rem";
+    caption.append(`${file} · `, link);
+    pane.replaceChildren(caption, frame);
+  }
+
+  function renderPdf(record) {
+    showPdf(pdfPane, record.file, record.pdf_url, `${record.student} — ${record.file}`,
+      `The original PDF (${record.file}) was not found in work-folder or pdf-folder.`);
+  }
+
+  // Letters tab: the selected letter's PDF on the left, every letter and its
+  // (post_rank) rank on the right; click a letter to show it.
+  function renderLetters(record) {
+    const letters = record.letters || [];
+    tabs.letters[0].textContent = `Recommendation letters (${letters.length})`;
+    if (!letters.length) {
+      letterPdfPane.replaceChildren();
+      lettersPane.replaceChildren(el("p", "No recommendation letters for this student.", "panel"));
+      return;
+    }
+    const summary = el("p", null, "hint");
+    summary.style.margin = "0 0 .5rem";
+    summary.textContent = `Recommend letter: ${record.letter_rank || "not ranked yet"}`;
+    const tbl = el("table", null, "courses");
+    const head = tbl.createTHead().insertRow();
+    head.append(el("th", "Letter"), el("th", "Rank"));
+    const tbody = tbl.createTBody();
+    function select(index) {
+      const letter = letters[index];
+      [...tbody.rows].forEach((row, i) => row.classList.toggle("in-category", i === index));
+      showPdf(letterPdfPane, letter.file, letter.pdf_url, letter.file, "");
+    }
+    letters.forEach((letter, index) => {
+      const row = tbody.insertRow();
+      row.className = "student";
+      row.tabIndex = 0;
+      row.append(el("td", letter.file, "code"), el("td", letter.rank || "not ranked"));
+      row.addEventListener("click", () => select(index));
+      row.addEventListener("keydown", (e) => {
+        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(index); }
+      });
+    });
+    const wrap = el("div", null, "table-wrap scroll");
+    wrap.append(tbl);
+    lettersPane.replaceChildren(summary, wrap);
+    select(0);
+  }
+
+  function renderCourses(record, category) {
+    if (!category) {
+      coursesPane.replaceChildren(el("p",
+        "No category results yet: build a category to see this transcript's courses.", "panel"));
+      return;
+    }
+    const courses = record.courses || [];
+    if (!courses.length) {
+      coursesPane.replaceChildren(el("p", "No courses were extracted from this transcript.", "panel"));
+      return;
+    }
+    const tbl = el("table", null, "courses");
+    const head = tbl.createTHead().insertRow();
+    for (const [label, cls] of [["Term"], ["Code"], ["Title"], ["Grade"],
+        [record.credit_label || "Credits", "num"], ["Points (4.0)", "num"], [category], ["In GPA"]]) {
+      head.append(el("th", label, cls));
+    }
+    const tbody = tbl.createTBody();
+    let lastTerm = null;
+    for (const c of courses) {
+      const row = tbody.insertRow();
+      if (c.in_category) row.className = "in-category";
+      // Show each term once, at the first course in it.
+      row.append(el("td", c.term === lastTerm ? "" : c.term, "term"));
+      lastTerm = c.term;
+      row.append(el("td", c.code, "code"), el("td", c.title), el("td", c.grade),
+        el("td", fmt(c.credits, 1), "num"), el("td", fmt(c.grade_points_4pt, 2), "num"),
+        el("td", c.in_category ? "✓" : ""), el("td", c.counts_toward_gpa ? "✓" : "no"));
+    }
+    const wrap = el("div", null, "table-wrap scroll");
+    wrap.append(tbl);
+    coursesPane.replaceChildren(wrap);
+  }
+
+  return async function openStudent(file, { builder = "", category = "", title: label = "" } = {}) {
+    title.textContent = label;
+    meta.textContent = "";
+    pdfPane.replaceChildren(el("p", "Loading…", "hint"));
+    coursesPane.replaceChildren();
+    letterPdfPane.replaceChildren();
+    lettersPane.replaceChildren();
+    tabs.letters[0].textContent = "Recommendation letters";
+    showTab("transcript");
+    dialog.showModal();
+    try {
+      const query = new URLSearchParams({ file });
+      if (category) { query.set("builder", builder); query.set("category", category); }
+      const response = await fetch(`/view/student?${query}`);
+      const data = await response.json().catch(() => ({ error: `server returned ${response.status}` }));
+      if (!response.ok) throw new Error(data.error || `server returned ${response.status}`);
+
+      title.textContent = data.student;
+      meta.textContent = [
+        data.institution, data.program,
+        category && `${category} GPA ${fmt(data.gpa_capped, 3)}`,
+        category && `all courses ${fmt(data.overall_gpa_capped, 3)}`,
+        category && `${data.category_courses} of ${data.total_courses} courses in ${category}`,
+        `recommend letter ${data.letter_rank || "–"}`,
+      ].filter(Boolean).join(" · ");
+      renderPdf(data);
+      renderCourses(data, category);
+      renderLetters(data);
+    } catch (err) {
+      pdfPane.replaceChildren();
+      coursesPane.replaceChildren(el("div", `Error: ${err.message}`, "error"));
+    }
+  };
+})();
+</script>
diff --git a/backup/claude-2026-10-23/browser_view/templates/letters_upload.html b/browser_view/templates/letters_upload.html
new file mode 100644
index 0000000..c0ff49b
--- /dev/null
+++ b/browser_view/templates/letters_upload.html
@@ -0,0 +1,135 @@
+{% extends "base.html" %}
+
+{% block title %}Transcripts and Recommendation Letters — letters upload{% endblock %}
+
+{% block body %}
+<section aria-labelledby="letters-heading" class="help">
+<h2 id="letters-heading" style="margin-top:0">Upload</h2>
+<form id="letters-form" method="post" action="/letters/upload" enctype="multipart/form-data">
+  <fieldset>
+    <legend>Recommendation letters</legend>
+    <label for="letter-pdfs">Upload letters</label>
+    <input type="file" id="letter-pdfs" name="pdfs" accept="application/pdf,.pdf" multiple>
+    <p class="hint">Leave empty to take every PDF already in <code>{{ folder }}</code>,
+      the <code>letters-folder</code> in config.yaml. A letter that already has a
+      <code>&lt;name&gt;.txt</code> there was uploaded before and is skipped.</p>
+  </fieldset>
+
+  <fieldset>
+    <legend>Output</legend>
+    <p class="hint" style="margin-top:0">New PDFs are saved in <code>{{ folder }}</code>.
+      Each becomes <code>&lt;name&gt;.txt</code>
+      (<code>pdftotext -layout</code>), and Jev ranks it as an excellent, good or normal
+      letter, about a second per letter. The ranks are added to
+      <code>{{ folder }}/letter_ranks.csv</code>, which the View page shows.</p>
+  </fieldset>
+
+  <button type="submit">Upload</button>
+</form>
+
+<div id="letters-progress" class="progress" hidden>
+  <progress id="letters-progress-bar"></progress>
+</div>
+<div id="letters-status" class="status" role="status" aria-live="polite" hidden></div>
+</section>
+
+<script>
+(() => {
+  const form = document.getElementById("letters-form");
+  const button = form.querySelector("button[type=submit]");
+  const status = document.getElementById("letters-status");
+  const progress = document.getElementById("letters-progress");
+  const bar = document.getElementById("letters-progress-bar");
+  let poller = null;
+
+  // textContent throughout: messages carry file names and paths.
+  function show(kind, title, lines = [], link = null) {
+    const box = document.createElement("div");
+    box.className = kind;
+    const head = document.createElement("strong");
+    head.textContent = title;
+    box.append(head);
+    if (link) {
+      const a = document.createElement("a");
+      a.href = link.href;
+      a.textContent = link.text;
+      box.append(" ", a);
+    }
+    if (lines.length) {
+      const list = document.createElement("ul");
+      list.className = "notes";
+      for (const line of lines) {
+        const item = document.createElement("li");
+        item.textContent = line;
+        list.append(item);
+      }
+      box.append(list);
+    }
+    status.replaceChildren(box);
+    status.hidden = false;
+  }
+
+  function render(state) {
+    const running = state.status === "running";
+    button.disabled = running;
+    progress.hidden = !running;
+    if (running) {
+      bar.max = state.total || 1;
+      bar.value = state.done || 0;
+      show("running", `Ranking… ${state.done} of ${state.total} letters, ${state.elapsed}s`);
+      return;
+    }
+    clearInterval(poller);
+    poller = null;
+    const failures = (state.failures || []).map(f => `${f.file}: ${f.error}`);
+    const skipped = (state.skipped || []).map(name => `${name}: already uploaded, skipped`);
+    if (state.status === "skipped") {
+      show("ok", `Nothing new: all ${skipped.length} letter(s) were uploaded before.`, skipped,
+        { href: "/letters/view", text: "View ranks" });
+    } else if (state.status === "done") {
+      show(failures.length ? "error" : "ok",
+        `Ranked ${state.ranked} of ${state.total} new letters in ${state.elapsed}s` +
+        (failures.length ? `; ${failures.length} failed` : "") +
+        (skipped.length ? `; ${skipped.length} skipped.` : "."),
+        [...failures, ...skipped], { href: "/letters/view", text: "View ranks" });
+    } else if (state.status === "error") {
+      show("error", `Error: ${state.error}`, failures);
+    }
+  }
+
+  async function poll() {
+    try {
+      const response = await fetch("/letters/status");
+      render(await response.json());
+    } catch (err) {
+      clearInterval(poller);
+      poller = null;
+      button.disabled = false;
+      show("error", `Error: ${err.message}`);
+    }
+  }
+  function follow() { if (!poller) poller = setInterval(poll, 1000); }
+
+  form.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    button.disabled = true;
+    show("running", "Uploading…");
+    try {
+      const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
+      const data = await response.json().catch(() => ({ error: `server returned ${response.status}` }));
+      if (!response.ok && data.status !== "running") throw new Error(data.error);
+      render(data);
+      follow();
+    } catch (err) {
+      button.disabled = false;
+      show("error", `Error: ${err.message}`);
+    }
+  });
+
+  // A run started earlier (or in another tab) keeps reporting here.
+  fetch("/letters/status").then(r => r.json()).then(state => {
+    if (state.status === "running") { render(state); follow(); }
+  }).catch(() => {});
+})();
+</script>
+{% endblock %}
