+class LetterJob:
+    """The one background run that converts recommendation letters and ranks them.
+
+    Each Jev call takes about a second, so a folder of letters takes minutes;
+    the FTP Upload page polls /letters/status meanwhile.  The ranks are merged
+    into <letters-folder>/letter_ranks.csv when the run ends.
+    """
+
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.state: dict = {"status": "idle"}
+
+    def snapshot(self) -> dict:
+        with self.lock:
+            state = dict(self.state)
+        if state.get("started"):
+            state["elapsed"] = round((state.get("finished") or time.time()) - state["started"])
+        return state
+
+    def start(self, client, pdfs: list[Path], ranks_csv: Path, skipped: list[str] = ()) -> bool:
+        with self.lock:
+            if self.state.get("status") == "running":
+                return False
+            self.state = {"status": "running", "done": 0, "total": len(pdfs),
+                          "skipped": list(skipped), "started": time.time()}
+        threading.Thread(target=self._run, args=(client, pdfs, ranks_csv), daemon=True).start()
+        return True
+
+    def _run(self, client, pdfs: list[Path], ranks_csv: Path) -> None:
+        ranks, failures = [], []
+        try:
+            for pdf in pdfs:
+                try:
+                    txt = pdf2txt.convert_one(pdf)
+                    choice, confidence = rank_letters.rank(client, txt.read_text(encoding="utf-8"))
+                except (RuntimeError, JevError, OSError) as exc:
+                    failures.append({"file": pdf.name, "error": str(exc)})
+                    log.error("letter %s: %s", pdf.name, exc)
+                else:
+                    ranks.append((txt.name, choice, confidence))
+                with self.lock:
+                    self.state["done"] += 1
+            if ranks:
+                rank_letters.merge_ranks(ranks_csv, ranks)
+        except Exception as exc:  # shown on the page; the thread must not die silently
+            log.exception("letter ranking failed")
+            update = {"status": "error", "error": str(exc)}
+        else:
+            log.info("letters: ranked %d of %d into %s", len(ranks), len(pdfs), ranks_csv)
+            update = {"status": "done" if ranks else "error", "ranked": len(ranks),
+                      "error": None if ranks else "no letter could be ranked"}
+        with self.lock:
+            self.state.update(update, failures=failures, csv=str(ranks_csv), finished=time.time())
+
+
+def _student_name(file: str) -> str:
+    """adam_flores.pdf -> Adam Flores."""
+    return Path(file).stem.replace("_", " ").title()
+
+
+def _transcript_names(cfg: dict) -> list[str]:
+    """Every transcript PDF's name, from work-folder and pdf-folder (as _find_pdf looks)."""
+    names = set()
+    for key in ("work-folder", "pdf-folder"):
+        if cfg.get(key):
+            names.update(p.name for p in Path(cfg[key]).expanduser().glob("*.pdf"))
+    return sorted(names)
+
+
+def _letter_students(cfg: dict, names: dict[str, str] | None = None) -> list[dict]:
+    """Recommendations → View rows: one per student with letters, from student_info.
+
+    ``names`` maps a transcript file to the student's name from category results;
+    a student not in it is named after their file."""
+    names = names or {}
+    folder = letters_folder(cfg)
+    records = letter_students.student_info(_transcript_names(cfg), sorted(folder.glob("*.pdf")),
+                                           letter_students.letter_ranks(folder))
+    return [{"student": names.get(r["transcript"]) or _student_name(r["student"]),
+             "file": r["transcript"] or f"{r['student']}.pdf",
+             "has_transcript": r["transcript"] is not None,
+             "letters": len(r["letters"]), "group_rank": r["group_rank"]}
+            for r in records if r["letters"]]
+
+
+def _add_letter_ranks(students: list[dict], folder: Path) -> None:
+    """Set each student's ``letter_rank``: student_info's group_rank of their
+    recommendation letters (matched by file name), else None."""
+    try:
+        letters = sorted(folder.glob("*.pdf"))
+        ranks = letter_students.letter_ranks(folder)
+    except (OSError, ValueError, KeyError, csv.Error) as exc:
+        log.error("letter ranks from %s: %s", folder, exc)
+        letters, ranks = [], {}
+    records = letter_students.student_info([s["file"] for s in students if s["file"]], letters, ranks)
+    by_transcript = {r["transcript"]: r["group_rank"] for r in records if r["transcript"]}
+    for s in students:
+        s["letter_rank"] = by_transcript.get(s["file"])
+
+
+def _student_letters(transcript: str, folder: Path) -> dict:
+    """{"letters": [{file, rank, pdf_url}], "letter_rank": group rank} for one
+    student, from student_info on their transcript's name."""
+    try:
+        letters = sorted(folder.glob("*.pdf"))
+        ranks = letter_students.letter_ranks(folder)
+    except (OSError, ValueError, KeyError, csv.Error) as exc:
+        log.error("letters for %s from %s: %s", transcript, folder, exc)
+        letters, ranks = [], {}
+    record = letter_students.student_info([transcript], letters, ranks)
+    record = next((r for r in record if r["transcript"] == transcript), None)
+    if record is None:
+        return {"letters": [], "letter_rank": None}
+    return {"letter_rank": record["group_rank"],
+            "letters": [{**letter, "pdf_url": f"/letters/pdf?{urlencode({'file': letter['file']})}"}
+                        for letter in record["letters"]]}
+
+
